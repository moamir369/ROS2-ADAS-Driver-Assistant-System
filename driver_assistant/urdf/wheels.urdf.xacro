<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="car">

    <xacro:property name="wheel_radius" value="0.280" />
    <xacro:property name="wheel_length" value="0.095" />

    <xacro:property name="front_wheel_x" value="0.765" />
    <xacro:property name="front_wheel_y" value="0.6845" />

    <xacro:property name="rear_wheel_x" value="-0.93" />
    <xacro:property name="rear_wheel_y" value="0.75" />


    <xacro:macro name="wheel_link" params="name direction">
        <link name="${name}">
            <visual>
                <xacro:if value="${direction == 'left'}">
                    <origin xyz="0.0 -${0.048 + 0.021} 0.0" rpy="0.0 0.0 ${pi}" />
                </xacro:if>

                <xacro:if value="${direction == 'right'}">
                    <origin xyz="0.0 ${0.048 + 0.021} 0.0" rpy="0.0 0.0 0.0" />
                </xacro:if>

                <geometry>
                    <mesh filename="file://$(find driver_assistant)/meshes/wheel.dae" />
                </geometry>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="${pi / 2} 0.0 0.0" />
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
            </collision>

            <xacro:inertial_cylinder mass="0.5" radius="${wheel_radius}" length="${wheel_length}"
                xyz="0 0 0"
                rpy="${pi/2} 0 0" />
        </link>
    </xacro:macro>

    <link name="left_axle">
        <xacro:inertial_box mass="5" x="0.6" y="0.4" z="0.2" xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </link>

    <link name="right_axle">
        <xacro:inertial_box mass="5" x="0.6" y="0.4" z="0.2" xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </link>

    <xacro:wheel_link name="front_left_wheel" direction="left" />
    <xacro:wheel_link name="front_right_wheel" direction="right" />
    <xacro:wheel_link name="rear_left_wheel" direction="left" />
    <xacro:wheel_link name="rear_right_wheel" direction="right" />

    <joint name="front_left_steer_joint" type="revolute">
        <origin xyz="${front_wheel_x} ${front_wheel_y} -0.15" rpy="0.0 0.0 0.0" />
        <parent link="base_link" />
        <child link="left_axle" />
        <axis xyz="0.0 0.0 1.0" />
        <limit lower="-0.8" upper="0.8" effort="10000000.0" velocity="10000000.0" />
    </joint>

    <joint name="front_right_steer_joint" type="revolute">
        <origin xyz="${front_wheel_x} -${front_wheel_y} -0.15" rpy="0.0 0.0 0.0" />
        <parent link="base_link" />
        <child link="right_axle" />
        <axis xyz="0.0 0.0 1.0" />
        <limit lower="-0.8" upper="0.8" effort="10000000.0" velocity="10000000.0" />
    </joint>

    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="left_axle" />
        <child link="front_left_wheel" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="right_axle" />
        <child link="front_right_wheel" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="rear_left_wheel_joint" type="continuous">
        <origin xyz="${rear_wheel_x} ${rear_wheel_y} -0.15" rpy="0.0 0.0 0.0" />
        <parent link="base_link" />
        <child link="rear_left_wheel" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="rear_right_wheel_joint" type="continuous">
        <origin xyz="${rear_wheel_x} -${rear_wheel_y} -0.15" rpy="0.0 0.0 0.0" />
        <parent link="base_link" />
        <child link="rear_right_wheel" />
        <axis xyz="0 1 0" />
    </joint>

</robot>