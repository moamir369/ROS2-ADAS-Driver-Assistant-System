<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo reference="shell_link">
        <visual>
            <material>
                <ambient>0.05 0.10 0.35 1</ambient>
                <diffuse>0.08 0.18 0.60 1</diffuse>
                <specular>0.9 0.9 1.0 1</specular>
                <emissive>0 0 0 1</emissive>
            </material>
        </visual>
    </gazebo>

    <xacro:macro name="wheel_material" params="link_name">
        <gazebo reference="${link_name}">
            <visual>
                <material>
                    <ambient>0.03 0.03 0.03 1</ambient>
                    <diffuse>0.05 0.05 0.05 1</diffuse>
                    <specular>0.1 0.1 0.1 1</specular>
                </material>
            </visual>
        </gazebo>
    </xacro:macro>

    <xacro:wheel_material link_name="front_left_wheel"/>
    <xacro:wheel_material link_name="front_right_wheel"/>
    <xacro:wheel_material link_name="rear_left_wheel"/>
    <xacro:wheel_material link_name="rear_right_wheel"/>

</robot>