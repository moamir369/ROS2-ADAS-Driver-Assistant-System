    install_requires=['setuptools'],
    zip_safe=True,
    maintainer='emir',
    maintainer_email='mo.amir.h.dev@gmail.com',
    description='TODO: Package description',
    license='TODO: License declaration',
    extras_require={
        'test': [
            'pytest',
        ],
    },
    entry_points={
        'console_scripts': [
            'lane_detector_node = lane_detection_cnn.lane_detector_node:main',
            'lane_cnn_node = lane_detection_cnn.lane_cnn_node:main',
            'lane_overlay_node = lane_detection_cnn.lane_overlay_node:main',
