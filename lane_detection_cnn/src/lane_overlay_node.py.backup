

import cv2
import numpy as np
import rclpy

from rclpy.node import Node
from sensor_msgs.msg import Image
from cv_bridge import CvBridge
from message_filters import Subscriber, ApproximateTimeSynchronizer


class LaneOverlayNode(Node):
    def __init__(self):
        super().__init__('lane_overlay_node')
        self.bridge = CvBridge()

        self.image_sub = Subscriber(
            self, Image, '/front/image_raw'
        )
        self.mask_sub = Subscriber(
            self, Image, '/lane_detection/mask'
        )

        self.sync = ApproximateTimeSynchronizer(
            [self.image_sub, self.mask_sub],
            queue_size=10,
            slop=0.1
        )
        self.sync.registerCallback(self.callback)

        self.publisher = self.create_publisher(
            Image, '/lane_detection/overlay', 10
        )

        self.get_logger().info(
            'Overlay node ready: /lane_detection/overlay'
        )

    def callback(self, image_msg, mask_msg):
        try:
            image = self.bridge.imgmsg_to_cv2(
                image_msg, desired_encoding='bgr8'
            )
            mask = self.bridge.imgmsg_to_cv2(
                mask_msg, desired_encoding='mono8'
            )

            mask = cv2.resize(
                mask, (image.shape[1], image.shape[0]),
                interpolation=cv2.INTER_NEAREST
            )

            overlay = image.copy()
            overlay[mask > 127] = (0, 255, 0)
            result = cv2.addWeighted(
                image, 0.7, overlay, 0.3, 0
            )

            output = self.bridge.cv2_to_imgmsg(
                result, encoding='bgr8'
            )
            output.header = image_msg.header
            self.publisher.publish(output)

        except Exception as exc:
            self.get_logger().error(f'Overlay error: {exc}')


def main(args=None):
    rclpy.init(args=args)
    node = LaneOverlayNode()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
