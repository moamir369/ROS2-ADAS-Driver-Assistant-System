import rclpy
import numpy as np

from rclpy.node import Node
from sensor_msgs.msg import Image
from cv_bridge import CvBridge
from message_filters import Subscriber, ApproximateTimeSynchronizer


class LaneOverlayNode(Node):
    def __init__(self):
        super().__init__('lane_overlay_node')

        self.bridge = CvBridge()

        self.image_sub = Subscriber(
            self, Image, '/front/image_raw'
        )
        self.mask_sub = Subscriber(
            self, Image, '/lane_detection/mask'
        )

        self.sync = ApproximateTimeSynchronizer(
            [self.image_sub, self.mask_sub],
            queue_size=10,
            slop=0.2
        )
        self.sync.registerCallback(self.callback)

        self.publisher = self.create_publisher(
            Image, '/lane_detection/overlay', 10
        )

        self.get_logger().info(
            'Overlay ready: /front/image_raw + /lane_detection/mask'
        )
        self.get_logger().info(
            'Publishing combined image to /lane_detection/overlay'
        )

    def callback(self, image_msg, mask_msg):
        stage = 'image conversion'

        try:
            image = self.bridge.imgmsg_to_cv2(
                image_msg, desired_encoding='bgr8'
            )
            mask = self.bridge.imgmsg_to_cv2(
                mask_msg, desired_encoding='mono8'
            )

            if image.ndim != 3 or image.shape[2] != 3:
                raise ValueError(f'Unexpected image shape: {image.shape}')

            if mask.ndim != 2:
                raise ValueError(f'Unexpected mask shape: {mask.shape}')

            # Resize the mask using NumPy nearest-neighbor indexing.
            stage = 'mask resizing'
            height, width = image.shape[:2]
            rows = np.minimum(
                (np.arange(height) * mask.shape[0] / height).astype(int),
                mask.shape[0] - 1
            )
            cols = np.minimum(
                (np.arange(width) * mask.shape[1] / width).astype(int),
                mask.shape[1] - 1
            )
            mask = mask[rows[:, None], cols[None, :]]

            # Blend detected lane pixels with green.
            stage = 'overlay creation'
            result = image.copy()
            active = mask > 127

            if np.any(active):
                green = np.array([0, 255, 0], dtype=np.float32)
                pixels = result[active].astype(np.float32)
                result[active] = (
                    0.45 * pixels + 0.55 * green
                ).astype(np.uint8)

            # Publish the combined image.
            stage = 'message publishing'
            output = self.bridge.cv2_to_imgmsg(
                result, encoding='bgr8'
            )
            output.header = image_msg.header
            self.publisher.publish(output)

        except Exception as exc:
            self.get_logger().error(
                f'{stage}: {type(exc).__name__}: {exc}'
            )


def main(args=None):
    rclpy.init(args=args)
    node = LaneOverlayNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
